<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CalculadoraIMC</RootNamespace>
    <AssemblyName>CalculadoraIMC</AssemblyName>
  </PropertyGroup>

  <!-- A pasta calculadorIMC contém um projeto antigo/duplicado.
       Excluí-la evita que os respetivos .cs sejam compilados duas vezes. -->
  <ItemGroup>
    <Compile Remove="calculadorIMC\**\*.cs" />
  </ItemGroup>
</Project>
